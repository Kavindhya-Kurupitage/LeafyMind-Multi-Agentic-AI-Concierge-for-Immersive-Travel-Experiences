# =============================================================================
# LeafyMind — Git ignore
# =============================================================================
# Keep tracked: .env.example, docs/, db/migrations/, frontend/public/ assets
# Never commit: secrets, dependencies, caches, local build output
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Allow the template (do not ignore)
!.env.example

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# -----------------------------------------------------------------------------
# Python (backend)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python packaging output at repo root (not frontend/dist — see Node section)
/dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Pip / user installs (e.g. docker exec pip install)
.local/
pip-log.txt
pip-delete-this-directory.txt

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
pytestdebug.log

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node.js (frontend, bff)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Frontend production build (Vite)
frontend/dist/

# Optional npm cache
.npm
.eslintcache
.stylelintcache

# -----------------------------------------------------------------------------
# AI / ML caches & generated indexes (backend)
# -----------------------------------------------------------------------------
backend/data/faiss/
backend/.cache/

# Hugging Face / sentence-transformers (any path)
.cache/
**/.cache/huggingface/

# -----------------------------------------------------------------------------
# Logs & runtime
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Databases (local dev only — schema lives in db/migrations/)
# -----------------------------------------------------------------------------
*.sqlite3
*.sqlite
*.db

# -----------------------------------------------------------------------------
# Docker (local overrides, not compose volumes)
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml
docker-compose.*.local.yml

# -----------------------------------------------------------------------------
# IDE & editors
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Cursor (keep .cursor/rules/ committed; ignore local-only)
.cursor/projects/
.cursor/*.json
!.cursor/rules/

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Misc temporary & backup
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*~

# Generated trip plan PDFs (keep any intentional assets under frontend/public if needed)
Leafy-Cave-Trip-Plan*.pdf
