# =============================================================================
# LeafyMind — Environment Variables Template
# =============================================================================
# Copy to .env and fill in real values before running:
#   cp .env.example .env
#
# Never commit .env to version control.
# Full setup guide: docs/EXTERNAL_SERVICES_SETUP.md
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=leafymind
POSTGRES_PASSWORD=change_me_secure_password_min_8_chars
POSTGRES_DB=leafymind
# Host port mapped by docker-compose (5433 avoids conflict with local Postgres on 5432)
POSTGRES_PORT=5433
# Inside Docker network, hostname is "postgres" and port is 5432
DATABASE_URL=postgresql+asyncpg://leafymind:change_me_secure_password_min_8_chars@postgres:5432/leafymind
# SQL migrations mounted into backend container
MIGRATIONS_DIR=/app/migrations

# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32  (must be >= 32 characters)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# -----------------------------------------------------------------------------
# LLM provider (GROQ recommended | OPENAI optional)
# -----------------------------------------------------------------------------
# GEMINI is not supported in current config — use GROQ or OPENAI
LLM_PROVIDER=GROQ
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Required when LLM_PROVIDER=GROQ — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI embeddings for FAISS rebuild only (chat uses Groq by default)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Food images (local branding + Unsplash fallback)
# -----------------------------------------------------------------------------
# Docker mounts frontend/public/images/food → /app/food_images
FOOD_IMAGES_DIR=/app/food_images
FOOD_IMAGES_URL_PREFIX=/images/food
# Docker mounts frontend/public → /app/public_assets (logo.png for trip pack PDF)
PUBLIC_ASSETS_DIR=/app/public_assets

# Unsplash Access Key — used when no local dish photo exists
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# -----------------------------------------------------------------------------
# Itinerary — OpenTripMap nearby discoveries
# -----------------------------------------------------------------------------
# https://opentripmap.io/
OPENTRIPMAP_API_KEY=your_opentripmap_key_here
CABANA_LAT=6.7311
CABANA_LON=81.1003
CABANA_NAME=Leafy Cave Cabana, Wellawaya
MAX_SEARCH_RADIUS_KM=100

# -----------------------------------------------------------------------------
# Email (Gmail SMTP)
# -----------------------------------------------------------------------------
# Trip plan PDF emails + post-stay feedback survey (on-demand / scheduled)
# Use Google App Password, NOT your normal Gmail password
# https://myaccount.google.com/apppasswords
GMAIL_SENDER_ADDRESS=your_leafycave_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
FEEDBACK_EMAIL_DELAY_DAYS=1

# Must match how guests open the app (used in email links and food image URLs)
FRONTEND_URL=http://localhost:5174

# -----------------------------------------------------------------------------
# Service ports (host machine)
# -----------------------------------------------------------------------------
# Adjust if ports conflict with other local apps
BACKEND_PORT=8010
BFF_PORT=3002
FRONTEND_PORT=5174

# -----------------------------------------------------------------------------
# CORS & frontend API
# -----------------------------------------------------------------------------
# Comma-separated; no wildcards in production
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3002
NODE_ENV=development

# Browser → BFF (must include /api suffix)
VITE_API_BASE_URL=http://localhost:3002/api

# BFF → backend (Docker internal DNS)
BFF_BACKEND_URL=http://backend:8000
# Port BFF listens on inside its container (docker-compose maps host BFF_PORT → 3001)
BFF_PORT=3001

# -----------------------------------------------------------------------------
# Optional: pgAdmin (dev-tools profile only)
# -----------------------------------------------------------------------------
# docker compose --profile dev-tools up -d
PGADMIN_DEFAULT_EMAIL=admin@leafycave.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin
PGADMIN_PORT=5050
